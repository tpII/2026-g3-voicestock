# Copy this file to `.env` and fill in local values.
# Never commit `.env` or real credentials.

# LLM provider identifier used by the application (for example: openai, groq).
# The concrete provider list is not fixed yet.
LLM_PROVIDER=

# API key for the selected provider, if that provider requires one.
LLM_API_KEY=

# Model name requested from the selected provider.
LLM_MODEL=

# PC communication server. Use 0.0.0.0 to accept connections from the local LAN.
VOICESTOCK_PC_HOST=127.0.0.1
VOICESTOCK_PC_PORT=8000

# Raspberry Pi web server. 192.168.50.1 is the Pi address on the Ethernet link.
# On a development machine set VOICESTOCK_WEB_HOST=127.0.0.1.
VOICESTOCK_WEB_HOST=192.168.50.1
VOICESTOCK_WEB_PORT=8000
