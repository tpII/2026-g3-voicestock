# Copy to a private file or export these variables in the shell.
# Do not commit real API keys.

VOICESTOCK_AUDIO_PIPELINE=groq
VOICESTOCK_CATALOG_PATH=/absolute/path/catalog.json
VOICESTOCK_GROQ_API_KEY=
VOICESTOCK_STT_MODEL=whisper-large-v3-turbo
VOICESTOCK_LLM_MODEL=openai/gpt-oss-20b
VOICESTOCK_STT_TIMEOUT_SECONDS=20
VOICESTOCK_LLM_TIMEOUT_SECONDS=20
VOICESTOCK_PC_HOST=192.168.50.2
VOICESTOCK_PC_PORT=8000

# The Raspberry client timeout must cover upload plus both requests above.
# VOICESTOCK_PC_TIMEOUT=60
